#!/usr/bin/env python3
"""TOTP store and clipboard helper for the Omarchy OTP bar plugin."""

from __future__ import annotations

import argparse
import base64
import fcntl
import getpass
import hashlib
import hmac
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
import uuid
from contextlib import contextmanager
from pathlib import Path
from urllib.parse import parse_qs, unquote, urlparse


CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
CONFIG_DIR = CONFIG_HOME / "omarchy-otp"
CONFIG_FILE = CONFIG_DIR / "accounts.json"
SUPPORTED_ALGORITHMS = {"SHA1": hashlib.sha1, "SHA256": hashlib.sha256, "SHA512": hashlib.sha512}
VERSION = "0.5.0"
ENCRYPTED_FORMAT = "omarchy-otp-encrypted"
ENCRYPTED_VERSION = 1
ENCRYPTION_AAD = b"omarchy-otp/accounts/v1"
KEYRING_ATTRIBUTES = ["application", "omarchy-otp", "purpose", "account-store"]


def ensure_store() -> None:
    if CONFIG_DIR.is_symlink():
        raise ValueError(f"Refusing symlinked configuration directory: {CONFIG_DIR}")
    CONFIG_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(CONFIG_DIR, 0o700)
    if CONFIG_FILE.is_symlink():
        raise ValueError(f"Refusing symlinked account store: {CONFIG_FILE}")
    if not CONFIG_FILE.exists():
        try:
            descriptor = os.open(CONFIG_FILE, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        except FileExistsError:
            pass
        else:
            with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
                handle.write("[]\n")
    os.chmod(CONFIG_FILE, 0o600)


@contextmanager
def store_lock():
    """Serialize account-store reads that may migrate and all writes."""
    ensure_store()
    lock_file = CONFIG_DIR / "accounts.lock"
    if lock_file.is_symlink():
        raise ValueError(f"Refusing symlinked account-store lock: {lock_file}")
    flags = os.O_RDWR | os.O_CREAT
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(lock_file, flags, 0o600)
    try:
        os.fchmod(descriptor, 0o600)
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(descriptor, fcntl.LOCK_UN)
        os.close(descriptor)


def read_json_file(path: Path) -> object:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ValueError(f"Could not read configuration: {exc}") from exc


def encrypted_document(data: object) -> bool:
    return isinstance(data, dict) and data.get("format") == ENCRYPTED_FORMAT


def encryption_backend():
    try:
        from cryptography.hazmat.primitives.ciphers.aead import AESGCM
        from cryptography.exceptions import InvalidTag
    except ImportError as exc:
        raise ValueError(
            "Encrypted storage requires the python-cryptography package"
        ) from exc
    return AESGCM, InvalidTag


def store_key(create: bool = False) -> bytes:
    if shutil.which("secret-tool") is None:
        raise ValueError("Encrypted storage requires secret-tool from libsecret")
    result = subprocess.run(
        ["secret-tool", "lookup", *KEYRING_ATTRIBUTES],
        capture_output=True,
        text=True,
        check=False,
    )
    encoded = result.stdout.strip() if result.returncode == 0 else ""
    if not encoded and create:
        key = os.urandom(32)
        encoded = base64.b64encode(key).decode("ascii")
        stored = subprocess.run(
            [
                "secret-tool", "store", "--label=Omarchy OTP account store",
                *KEYRING_ATTRIBUTES,
            ],
            input=encoded,
            capture_output=True,
            text=True,
            check=False,
        )
        if stored.returncode != 0:
            raise ValueError("Could not store the encryption key in GNOME Keyring")
        return key
    if not encoded:
        raise ValueError("Encrypted account store is locked or its key is unavailable")
    try:
        key = base64.b64decode(encoded, validate=True)
    except ValueError as exc:
        raise ValueError("The account-store key in GNOME Keyring is invalid") from exc
    if len(key) != 32:
        raise ValueError("The account-store key in GNOME Keyring has an invalid length")
    return key


def encrypt_accounts(accounts: list[dict], key: bytes) -> dict:
    AESGCM, _ = encryption_backend()
    nonce = os.urandom(12)
    plaintext = json.dumps(accounts, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    ciphertext = AESGCM(key).encrypt(nonce, plaintext, ENCRYPTION_AAD)
    return {
        "format": ENCRYPTED_FORMAT,
        "version": ENCRYPTED_VERSION,
        "algorithm": "AES-256-GCM",
        "nonce": base64.b64encode(nonce).decode("ascii"),
        "ciphertext": base64.b64encode(ciphertext).decode("ascii"),
    }


def decrypt_accounts(document: dict, key: bytes) -> list[dict]:
    if document.get("version") != ENCRYPTED_VERSION or document.get("algorithm") != "AES-256-GCM":
        raise ValueError("Unsupported encrypted account-store format")
    try:
        nonce = base64.b64decode(str(document["nonce"]), validate=True)
        ciphertext = base64.b64decode(str(document["ciphertext"]), validate=True)
    except (KeyError, ValueError) as exc:
        raise ValueError("Encrypted account store is malformed") from exc
    if len(nonce) != 12:
        raise ValueError("Encrypted account store has an invalid nonce")
    AESGCM, InvalidTag = encryption_backend()
    try:
        plaintext = AESGCM(key).decrypt(nonce, ciphertext, ENCRYPTION_AAD)
        accounts = json.loads(plaintext.decode("utf-8"))
    except (InvalidTag, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ValueError("Encrypted account store failed authentication") from exc
    if not isinstance(accounts, list):
        raise ValueError("Decrypted account store must contain a JSON list")
    return accounts


def _read_accounts_document() -> tuple[list[dict], object]:
    ensure_store()
    data = read_json_file(CONFIG_FILE)
    if encrypted_document(data):
        accounts = decrypt_accounts(data, store_key())
        return accounts, data
    if not isinstance(data, list):
        raise ValueError("accounts.json must contain a JSON list or encrypted store")
    return data, data


def write_json_file(path: Path, data: object) -> None:
    descriptor, temporary_name = tempfile.mkstemp(prefix=f"{path.name}.", suffix=".tmp", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        os.chmod(temporary, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(data, handle, indent=2, ensure_ascii=False)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        temporary.unlink(missing_ok=True)


def _save_accounts_unlocked(accounts: list[dict], current: object | None = None) -> None:
    normalized, _ = normalize_accounts(accounts)
    if current is None:
        current = read_json_file(CONFIG_FILE)
    data = encrypt_accounts(normalized, store_key()) if encrypted_document(current) else normalized
    write_json_file(CONFIG_FILE, data)


def _load_accounts_unlocked() -> list[dict]:
    accounts, document = _read_accounts_document()
    normalized, changed = normalize_accounts(accounts)
    if changed:
        _backup_accounts_unlocked()
        _save_accounts_unlocked(normalized, document)
    return normalized


def load_accounts() -> list[dict]:
    with store_lock():
        return _load_accounts_unlocked()


def save_accounts(accounts: list[dict]) -> None:
    with store_lock():
        _save_accounts_unlocked(accounts)


def convert_store_files(encrypt: bool, include_backups: bool = True) -> tuple[int, int]:
    with store_lock():
        targets = [CONFIG_FILE]
        if include_backups:
            targets.extend(sorted(CONFIG_DIR.glob("accounts.json.backup-*")))
        documents: list[tuple[Path, object]] = []
        for path in targets:
            if path.is_symlink():
                raise ValueError(f"Refusing symlinked account store: {path}")
            documents.append((path, read_json_file(path)))
        has_encrypted_file = any(encrypted_document(data) for _, data in documents)
        key = store_key(create=encrypt and not has_encrypted_file)
        converted: list[tuple[Path, object]] = []
        unchanged = 0
        for path, data in documents:
            if encrypt:
                if encrypted_document(data):
                    decrypt_accounts(data, key)
                    unchanged += 1
                    continue
                if not isinstance(data, list):
                    raise ValueError(f"Unexpected account-store format: {path.name}")
                envelope = encrypt_accounts(data, key)
                if decrypt_accounts(envelope, key) != data:
                    raise ValueError(f"Encryption self-check failed: {path.name}")
                converted.append((path, envelope))
            else:
                if not encrypted_document(data):
                    unchanged += 1
                    continue
                converted.append((path, decrypt_accounts(data, key)))
        for path, data in converted:
            write_json_file(path, data)
        return len(converted), unchanged


def _backup_accounts_unlocked() -> Path:
    ensure_store()
    timestamp = time.strftime("%Y%m%d-%H%M%S")
    backup = CONFIG_DIR / f"accounts.json.backup-{timestamp}"
    counter = 1
    while backup.exists():
        backup = CONFIG_DIR / f"accounts.json.backup-{timestamp}-{counter}"
        counter += 1
    shutil.copy2(CONFIG_FILE, backup)
    os.chmod(backup, 0o600)
    return backup


def backup_accounts() -> Path:
    with store_lock():
        return _backup_accounts_unlocked()


def normalize_account(account: dict) -> dict:
    if not isinstance(account, dict):
        raise ValueError("Each account entry must be a JSON object")
    name = str(account.get("name", "")).strip()
    issuer = str(account.get("issuer", "")).strip()
    secret = "".join(str(account.get("secret", "")).split()).upper().rstrip("=")
    account_id = str(account.get("id", "")).strip().lower()
    try:
        digits = int(account.get("digits", 6))
        period = int(account.get("period", 30))
    except (TypeError, ValueError) as exc:
        raise ValueError(f"Invalid OTP parameters for {name or 'unnamed account'}") from exc
    algorithm = str(account.get("algorithm", "SHA1")).upper()
    if not name or not secret:
        raise ValueError("Each account needs a name and secret")
    if digits not in (6, 7, 8):
        raise ValueError(f"Invalid digit count for {name}: {digits}")
    if period <= 0:
        raise ValueError(f"Invalid period for {name}: {period}")
    if algorithm not in SUPPORTED_ALGORITHMS:
        raise ValueError(f"Unsupported algorithm for {name}: {algorithm}")
    try:
        padded = secret + "=" * ((8 - len(secret) % 8) % 8)
        base64.b32decode(padded, casefold=True)
    except Exception as exc:
        raise ValueError(f"Invalid Base32 secret for {name}") from exc
    if account_id:
        try:
            account_id = str(uuid.UUID(account_id))
        except ValueError as exc:
            raise ValueError(f"Invalid account ID for {name}") from exc
    else:
        account_id = str(uuid.uuid4())
    return {
        "id": account_id,
        "name": name,
        "issuer": issuer,
        "secret": secret,
        "digits": digits,
        "period": period,
        "algorithm": algorithm,
    }


def normalize_accounts(accounts: list[dict]) -> tuple[list[dict], bool]:
    if not isinstance(accounts, list):
        raise ValueError("Account store must contain a JSON list")
    normalized = []
    seen_ids = set()
    changed = False
    for raw in accounts:
        account = normalize_account(raw)
        if account["id"] in seen_ids:
            account["id"] = str(uuid.uuid4())
        seen_ids.add(account["id"])
        normalized.append(account)
        if account != raw:
            changed = True
    return normalized, changed


def totp(account: dict, now: int | None = None) -> tuple[str, int]:
    account = normalize_account(account)
    timestamp = int(time.time()) if now is None else now
    counter = timestamp // account["period"]
    padded = account["secret"] + "=" * ((8 - len(account["secret"]) % 8) % 8)
    key = base64.b32decode(padded, casefold=True)
    digest = hmac.new(key, counter.to_bytes(8, "big"), SUPPORTED_ALGORITHMS[account["algorithm"]]).digest()
    offset = digest[-1] & 0x0F
    number = int.from_bytes(digest[offset : offset + 4], "big") & 0x7FFFFFFF
    code = str(number % (10 ** account["digits"])).zfill(account["digits"])
    remaining = account["period"] - (timestamp % account["period"])
    return code, remaining


def display_rows(accounts: list[dict]) -> list[dict]:
    now = int(time.time())
    rows = []
    for index, raw in enumerate(accounts):
        account = normalize_account(raw)
        code, remaining = totp(account, now)
        rows.append({
            "id": account["id"],
            "index": index,
            "name": account["name"],
            "issuer": account["issuer"],
            "code": code,
            "displayCode": f"{code[:3]} {code[3:]}" if len(code) == 6 else code,
            "remaining": remaining,
            "period": account["period"],
            "counter": now // account["period"],
        })
    return rows


def parse_otpauth(uri: str) -> dict:
    parsed = urlparse(uri.strip())
    if parsed.scheme != "otpauth" or parsed.netloc.lower() != "totp":
        raise ValueError("Expected an otpauth://totp/... URL")
    values = parse_qs(parsed.query)
    label = unquote(parsed.path.lstrip("/"))
    label_issuer, separator, label_name = label.partition(":")
    issuer = values.get("issuer", [label_issuer if separator else ""])[0]
    name = label_name if separator else label
    return normalize_account({
        "name": name,
        "issuer": issuer,
        "secret": values.get("secret", [""])[0],
        "digits": values.get("digits", [6])[0],
        "period": values.get("period", [30])[0],
        "algorithm": values.get("algorithm", ["SHA1"])[0],
    })


def merge_bitwarden_accounts(
    existing: list[dict], items: list[dict]
) -> tuple[list[dict], int, int, int]:
    merged = list(existing)
    known = set()
    for raw in existing:
        try:
            account = normalize_account(raw)
        except ValueError:
            continue
        known.add((account["secret"], account["digits"], account["period"], account["algorithm"]))

    imported = 0
    duplicates = 0
    invalid = 0
    for item in items:
        if not isinstance(item, dict):
            continue
        login = item.get("login")
        if not isinstance(login, dict):
            continue
        value = str(login.get("totp") or "").strip()
        if not value:
            continue
        item_name = str(item.get("name") or login.get("username") or "Bitwarden OTP").strip()
        try:
            if value.lower().startswith("otpauth://"):
                account = parse_otpauth(value)
                account["name"] = item_name
            else:
                account = normalize_account({"name": item_name, "secret": value})
        except ValueError:
            invalid += 1
            continue

        key = (account["secret"], account["digits"], account["period"], account["algorithm"])
        if key in known:
            duplicates += 1
            continue
        known.add(key)
        merged.append(account)
        imported += 1

    return merged, imported, duplicates, invalid


def bitwarden_session() -> tuple[str, str]:
    if shutil.which("bw") is None:
        raise ValueError("Bitwarden CLI is missing; install the bitwarden-cli package")
    status_result = subprocess.run(
        ["bw", "status"], capture_output=True, text=True, check=True
    )
    try:
        status = json.loads(status_result.stdout).get("status", "unauthenticated")
    except json.JSONDecodeError as exc:
        raise ValueError("Could not read Bitwarden CLI status") from exc

    command = ["bw", "login", "--raw"] if status == "unauthenticated" else ["bw", "unlock", "--raw"]
    result = subprocess.run(command, stdout=subprocess.PIPE, text=True, check=True)
    session = result.stdout.strip()
    if not session:
        raise ValueError("Bitwarden did not return an unlocked session")
    return session, status


def command_import_bitwarden() -> int:
    session, previous_status = bitwarden_session()
    environment = os.environ.copy()
    environment["BW_SESSION"] = session
    try:
        subprocess.run(
            ["bw", "sync"], env=environment, stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE, text=True, check=True,
        )
        result = subprocess.run(
            ["bw", "list", "items"], env=environment,
            capture_output=True, text=True, check=True,
        )
        try:
            items = json.loads(result.stdout)
        except json.JSONDecodeError as exc:
            raise ValueError("Could not read Bitwarden vault items") from exc
        if not isinstance(items, list):
            raise ValueError("Bitwarden returned an unexpected item list")

        with store_lock():
            accounts = _load_accounts_unlocked()
            merged, imported, duplicates, invalid = merge_bitwarden_accounts(accounts, items)
            if imported:
                backup = _backup_accounts_unlocked()
                _save_accounts_unlocked(merged)
        if imported:
            print(f"Imported {imported} OTP account(s).")
            print(f"Backup: {backup}")
        else:
            print("No new OTP accounts found.")
        if duplicates:
            print(f"Skipped {duplicates} duplicate(s).")
        if invalid:
            print(f"Skipped {invalid} invalid OTP entr{'y' if invalid == 1 else 'ies'}.")
    finally:
        session = ""
        environment.pop("BW_SESSION", None)
        if previous_status != "unlocked":
            subprocess.run(
                ["bw", "lock"], stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL, check=False,
            )
    return 0


def command_list() -> int:
    print(json.dumps({"accounts": display_rows(load_accounts())}, ensure_ascii=False))
    return 0


def command_copy(selector: str | int, clear_after: int) -> int:
    if shutil.which("wl-copy") is None:
        raise ValueError("wl-copy is missing; install the wl-clipboard package")
    if clear_after > 0 and shutil.which("wl-paste") is None:
        raise ValueError("wl-paste is missing; install the wl-clipboard package")
    with store_lock():
        accounts = _load_accounts_unlocked()
        _, account = resolve_account(accounts, selector)
        code, _ = totp(account)
    subprocess.run(["wl-copy"], input=code, text=True, check=True)
    if clear_after > 0:
        worker = subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "_clear", str(clear_after)],
            stdin=subprocess.PIPE,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            text=True,
            start_new_session=True,
        )
        if worker.stdin is not None:
            worker.stdin.write(code)
            worker.stdin.close()
    return 0


def command_clear(clear_after: int) -> int:
    code = sys.stdin.read()
    if not code:
        return 0
    time.sleep(max(0, clear_after))
    current = subprocess.run(
        ["wl-paste", "--no-newline"],
        capture_output=True,
        text=True,
        check=False,
    )
    if current.returncode == 0 and current.stdout == code:
        subprocess.run(["wl-copy", "--clear"], check=False)
    return 0


def command_add() -> int:
    print("Add an OTP account (the secret input is hidden)")
    value = getpass.getpass("Secret or otpauth:// URL: ").strip()
    if value.startswith("otpauth://"):
        account = parse_otpauth(value)
        override = input(f"Name [{account['name']}]: ").strip()
        if override:
            account["name"] = override
    else:
        name = input("Name: ").strip()
        issuer = input("Issuer (optional): ").strip()
        account = normalize_account({"name": name, "issuer": issuer, "secret": value})
    with store_lock():
        accounts = _load_accounts_unlocked()
        accounts.append(account)
        _save_accounts_unlocked(accounts)
    print(f"Added: {account['name']}")
    return 0


def resolve_account(accounts: list[dict], selector: str | int) -> tuple[int, dict]:
    value = str(selector).strip().lower()
    for index, account in enumerate(accounts):
        if str(account.get("id", "")).lower() == value:
            return index, account
    try:
        index = int(value)
    except ValueError as exc:
        raise ValueError("Account not found") from exc
    if index < 0 or index >= len(accounts):
        raise ValueError("Account not found")
    return index, accounts[index]


def command_remove(selector: str | int, assume_yes: bool) -> int:
    with store_lock():
        accounts = _load_accounts_unlocked()
        _, account = resolve_account(accounts, selector)
        account_id = account["id"]
        name = account["name"]

    if not assume_yes:
        if not sys.stdin.isatty():
            raise ValueError("Removal requires confirmation; use --yes")
        answer = input(f"Really remove {name}? [y/N] ").strip().lower()
        if answer not in ("y", "yes", "j", "ja"):
            print("Cancelled.")
            return 0

    with store_lock():
        accounts = _load_accounts_unlocked()
        index, account = resolve_account(accounts, account_id)
        accounts.pop(index)
        _save_accounts_unlocked(accounts)
    print(f"Removed: {name}")
    return 0


def command_show() -> int:
    accounts = load_accounts()
    if not accounts:
        print("No OTP accounts configured.")
        return 0
    for index, account in enumerate(accounts):
        normalized = normalize_account(account)
        suffix = f" ({normalized['issuer']})" if normalized["issuer"] else ""
        print(f"{index}: {normalized['name']}{suffix}")
    return 0


def command_encrypt_store() -> int:
    converted, unchanged = convert_store_files(encrypt=True)
    print(f"Encrypted {converted} account-store file(s) with AES-256-GCM.")
    if unchanged:
        print(f"Already encrypted: {unchanged} file(s).")
    print("The encryption key is stored in GNOME Keyring.")
    return 0


def command_decrypt_store(assume_yes: bool) -> int:
    if not assume_yes:
        if not sys.stdin.isatty():
            raise ValueError("Decryption requires confirmation; use --yes")
        answer = input("Write the account store and backups as plaintext? [y/N] ").strip().lower()
        if answer not in ("y", "yes", "j", "ja"):
            print("Cancelled.")
            return 0
    converted, unchanged = convert_store_files(encrypt=False)
    print(f"Decrypted {converted} account-store file(s) to plaintext.")
    if unchanged:
        print(f"Already plaintext: {unchanged} file(s).")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Manage OTP accounts for the Omarchy bar")
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    sub = parser.add_subparsers(dest="command")
    sub.add_parser("list", help=argparse.SUPPRESS)
    sub.add_parser("add", help="add an account interactively")
    sub.add_parser("import-bitwarden", help="import TOTP accounts from Bitwarden/Vaultwarden")
    sub.add_parser("encrypt-store", help="encrypt the account store and backups with GNOME Keyring")
    decrypt = sub.add_parser("decrypt-store", help="decrypt the account store and backups to plaintext")
    decrypt.add_argument("--yes", action="store_true", help="decrypt without confirmation")
    remove = sub.add_parser("remove", help="remove an account")
    remove.add_argument("account", help="account UUID or legacy list index")
    remove.add_argument("--yes", action="store_true", help="remove without confirmation")
    copy = sub.add_parser("copy", help=argparse.SUPPRESS)
    copy.add_argument("account", help=argparse.SUPPRESS)
    copy.add_argument("--clear-after", type=int, default=30)
    clear = sub.add_parser("_clear", help=argparse.SUPPRESS)
    clear.add_argument("seconds", type=int)
    sub.add_parser("show", help="list configured accounts")
    args = parser.parse_args()
    if args.command == "list":
        return command_list()
    if args.command == "copy":
        return command_copy(args.account, max(0, args.clear_after))
    if args.command == "_clear":
        return command_clear(args.seconds)
    if args.command == "add":
        return command_add()
    if args.command == "import-bitwarden":
        return command_import_bitwarden()
    if args.command == "encrypt-store":
        return command_encrypt_store()
    if args.command == "decrypt-store":
        return command_decrypt_store(args.yes)
    if args.command == "remove":
        return command_remove(args.account, args.yes)
    if args.command == "show":
        return command_show()
    parser.print_help()
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (ValueError, OSError, subprocess.CalledProcessError) as exc:
        print(str(exc), file=sys.stderr)
        raise SystemExit(1)
